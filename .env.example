# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.

# Neon Postgres connection string (TASK 09). Create a free project at
# https://neon.tech, then copy the connection string it gives you —
# looks like: postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Optional (TASK 10). Vercel sets this automatically once you configure
# a cron job on Vercel — you don't set it by hand there. Only fill this
# in locally if you want to test the Authorization check yourself; if
# left blank, /api/cron/capture-snapshots skips the auth check entirely
# (fine for local dev, NOT fine to leave unset once deployed publicly).
CRON_SECRET=

# Optional (TASK 12). Leave all four blank to use viem's own built-in
# public RPC endpoint for each chain — no signup needed, fine at this
# app's actual call volume (at most one capture pass a day). Only set
# one if you've signed up for a provider (e.g. Chainstack's free tier
# covers all four of these chains) and want more headroom than a
# shared public endpoint gives you. Setting one doesn't require setting
# the others — each is independent.
RPC_URL_ETHEREUM=
RPC_URL_BASE=
RPC_URL_ARBITRUM=
RPC_URL_BSC=
