# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.

# Neon Postgres connection string (TASK 09). Create a free project at
# https://neon.tech, then copy the connection string it gives you —
# looks like: postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Optional (TASK 10). Vercel sets this automatically once you configure
# a cron job on Vercel — you don't set it by hand there. Only fill this
# in locally if you want to test the Authorization check yourself; if
# left blank, /api/cron/capture-snapshots skips the auth check entirely
# (fine for local dev, NOT fine to leave unset once deployed publicly).
CRON_SECRET=
